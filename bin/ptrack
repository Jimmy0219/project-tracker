#!/usr/bin/env python3
"""ptrack — 專案進度追蹤器的命令列工具（只用 Python 標準函式庫）。

進度檔集中放在 ~/.project-tracker/projects/<slug>.md，
格式為 Markdown + YAML frontmatter，由 AI agent 在每次 session 收工前更新，
macOS 選單列 App 負責即時彙整顯示。

子指令：
  ptrack file  [路徑]           印出該專案進度檔的完整路徑（不存在也照印）
  ptrack init  [路徑] [--name N] 建立進度檔（已存在則不覆蓋），印出路徑
  ptrack stamp [路徑] [--agent A] 更新 frontmatter 的 updated／agent 欄位
  ptrack log   [路徑] 訊息...     在「歷程」區段追加一行（自動加時間戳）
  ptrack list                    列出所有追蹤中的專案
  ptrack root  [路徑]           印出判定的專案根目錄
  ptrack hook-stop               Claude Code Stop hook（從 stdin 讀 JSON）

[路徑] 省略時使用目前目錄；若位於 git repo 內，以 repo 根目錄為專案根目錄。
"""
from __future__ import annotations

import hashlib
import json
import os
import re
import subprocess
import sys
import unicodedata
from datetime import datetime
from pathlib import Path

HOME_DIR = Path(os.environ.get("PTRACK_HOME", Path.home() / ".project-tracker"))
PROJECTS_DIR = HOME_DIR / "projects"
EDIT_TOOLS = {"Edit", "Write", "MultiEdit", "NotebookEdit"}

TEMPLATE = """---
project: {name}
path: {path}
status: in_progress
agent:
updated: {now}
---

## 目前狀態

（尚未填寫：這個專案做到哪裡了）

## 下一步

- （下一個 agent 接手時要做的第一件事）

## 待辦

- [ ] （任務一）

## 卡關／待決事項

（無）

## 歷程

- {now_short} 建立進度檔
"""


# ---------- 專案識別 ----------

def project_root(start: str | os.PathLike | None = None) -> Path:
    """以 git repo 根目錄為專案根目錄；不在 repo 內就用該目錄本身。"""
    p = Path(start or os.getcwd()).expanduser().resolve()
    if p.is_file():
        p = p.parent
    try:
        out = subprocess.run(
            ["git", "-C", str(p), "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, timeout=5,
        )
        if out.returncode == 0 and out.stdout.strip():
            return Path(out.stdout.strip()).resolve()
    except (OSError, subprocess.SubprocessError):
        pass
    return p


def slug_for(root: Path) -> str:
    """資料夾名稱（保留中文）＋路徑雜湊前 6 碼，避免同名資料夾互撞。"""
    name = unicodedata.normalize("NFC", root.name) or "root"
    name = re.sub(r"[\s/\\:]+", "-", name).strip("-.") or "project"
    digest = hashlib.sha1(str(root).encode("utf-8")).hexdigest()[:6]
    return f"{name}-{digest}"


def progress_file(root: Path) -> Path:
    return PROJECTS_DIR / f"{slug_for(root)}.md"


def now_iso() -> str:
    return datetime.now().astimezone().isoformat(timespec="seconds")


def now_short() -> str:
    return datetime.now().astimezone().strftime("%Y-%m-%d %H:%M")


# ---------- frontmatter 小工具 ----------

FM_RE = re.compile(r"\A---\n(.*?)\n---\n?", re.S)


def set_frontmatter(text: str, updates: dict[str, str]) -> str:
    m = FM_RE.match(text)
    if not m:
        body = "".join(f"{k}: {v}\n" for k, v in updates.items())
        return f"---\n{body}---\n\n{text}"
    lines = m.group(1).split("\n")
    seen = set()
    for i, line in enumerate(lines):
        key = line.split(":", 1)[0].strip()
        if key in updates:
            lines[i] = f"{key}: {updates[key]}"
            seen.add(key)
    lines += [f"{k}: {v}" for k, v in updates.items() if k not in seen]
    return "---\n" + "\n".join(lines) + "\n---\n" + text[m.end():]


def read_frontmatter(text: str) -> dict[str, str]:
    m = FM_RE.match(text)
    out: dict[str, str] = {}
    if m:
        for line in m.group(1).split("\n"):
            if ":" in line:
                k, v = line.split(":", 1)
                out[k.strip()] = v.strip()
    return out


# ---------- 子指令 ----------

def cmd_file(args: list[str]) -> int:
    print(progress_file(project_root(args[0] if args else None)))
    return 0


def cmd_root(args: list[str]) -> int:
    print(project_root(args[0] if args else None))
    return 0


def pop_opt(args: list[str], flag: str) -> str | None:
    if flag in args:
        i = args.index(flag)
        if i + 1 >= len(args):
            sys.exit(f"ptrack: {flag} 需要一個值")
        val = args[i + 1]
        del args[i:i + 2]
        return val
    return None


def cmd_init(args: list[str]) -> int:
    name = pop_opt(args, "--name")
    root = project_root(args[0] if args else None)
    f = progress_file(root)
    if not f.exists():
        PROJECTS_DIR.mkdir(parents=True, exist_ok=True)
        f.write_text(TEMPLATE.format(
            name=name or root.name, path=root, now=now_iso(), now_short=now_short(),
        ), encoding="utf-8")
    print(f)
    return 0


def cmd_stamp(args: list[str]) -> int:
    agent = pop_opt(args, "--agent")
    f = progress_file(project_root(args[0] if args else None))
    if not f.exists():
        sys.exit(f"ptrack: 找不到進度檔 {f}，請先執行 ptrack init")
    updates = {"updated": now_iso()}
    if agent:
        updates["agent"] = agent
    f.write_text(set_frontmatter(f.read_text(encoding="utf-8"), updates), encoding="utf-8")
    print(f)
    return 0


def cmd_log(args: list[str]) -> int:
    path = None
    if args and Path(args[0]).expanduser().is_dir():
        path = args.pop(0)
    msg = " ".join(args).strip()
    if not msg:
        sys.exit("ptrack: 請提供歷程訊息")
    f = progress_file(project_root(path))
    if not f.exists():
        sys.exit(f"ptrack: 找不到進度檔 {f}，請先執行 ptrack init")
    text = f.read_text(encoding="utf-8").rstrip("\n")
    entry = f"- {now_short()} {msg}"
    if re.search(r"^## 歷程\s*$", text, re.M):
        text += "\n" + entry + "\n"
    else:
        text += "\n\n## 歷程\n\n" + entry + "\n"
    text = set_frontmatter(text, {"updated": now_iso()})
    f.write_text(text, encoding="utf-8")
    print(f)
    return 0


def cmd_list(_args: list[str]) -> int:
    files = sorted(PROJECTS_DIR.glob("*.md"), key=lambda p: p.stat().st_mtime, reverse=True)
    if not files:
        print("（尚無追蹤中的專案）")
        return 0
    for f in files:
        fm = read_frontmatter(f.read_text(encoding="utf-8"))
        ts = datetime.fromtimestamp(f.stat().st_mtime).strftime("%m-%d %H:%M")
        print(f"{ts}  {fm.get('status', '?'):<12} {fm.get('project', f.stem)}")
    return 0


# ---------- Claude Code Stop hook ----------

def parse_ts(s: str | None) -> float | None:
    if not s:
        return None
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def last_project_edit(transcript: Path, root: Path, pfile: Path) -> float | None:
    """回傳這次 session 中，最後一次用編輯工具改動專案內檔案的時間（epoch 秒）。"""
    last = None
    root_s = str(root) + os.sep
    try:
        fh = transcript.open(encoding="utf-8")
    except OSError:
        return None
    with fh:
        for line in fh:
            if '"tool_use"' not in line:
                continue
            try:
                rec = json.loads(line)
            except json.JSONDecodeError:
                continue
            if rec.get("type") != "assistant":
                continue
            ts = parse_ts(rec.get("timestamp"))
            if ts is None:
                continue
            content = (rec.get("message") or {}).get("content")
            if not isinstance(content, list):
                continue
            for item in content:
                if not isinstance(item, dict) or item.get("type") != "tool_use":
                    continue
                if item.get("name") not in EDIT_TOOLS:
                    continue
                inp = item.get("input") or {}
                fp = inp.get("file_path") or inp.get("notebook_path")
                if not fp:
                    continue
                try:
                    rp = Path(fp).expanduser().resolve()
                except OSError:
                    continue
                if rp == pfile or not str(rp).startswith(root_s):
                    continue
                last = ts if last is None else max(last, ts)
    return last


DEFAULT_IGNORES = ["~", "~/Desktop", "~/Documents", "~/Downloads", "/", "/tmp", "/private/tmp"]


def is_ignored(root: Path) -> bool:
    """容器資料夾（家目錄、Desktop…）與 ~/.project-tracker 本身不當成專案。
    額外路徑可寫在 ~/.project-tracker/ignore，一行一個；結尾加 /* 代表連子資料夾一起忽略。"""
    tracker = HOME_DIR.resolve()
    if root == tracker or tracker in root.parents:
        return True
    patterns = list(DEFAULT_IGNORES)
    ignore_file = HOME_DIR / "ignore"
    if ignore_file.is_file():
        patterns += [l.strip() for l in ignore_file.read_text(encoding="utf-8").splitlines()
                     if l.strip() and not l.lstrip().startswith("#")]
    for pat in patterns:
        recursive = pat.endswith("/*")
        base = Path(pat[:-2] if recursive else pat).expanduser().resolve()
        if root == base or (recursive and base in root.parents):
            return True
    return False


def cmd_hook_stop(_args: list[str]) -> int:
    try:
        data = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        return 0
    if data.get("stop_hook_active"):
        return 0  # 已經提醒過一次，避免無限迴圈
    if os.environ.get("PTRACK_DISABLE"):
        return 0
    cwd = data.get("cwd") or os.getcwd()
    root = project_root(cwd)
    if is_ignored(root):
        return 0
    transcript = Path(data.get("transcript_path") or "").expanduser()
    if not transcript.is_file():
        return 0
    pfile = progress_file(root)
    edited_at = last_project_edit(transcript, root, pfile.resolve())
    if edited_at is None:
        return 0  # 這次 session 沒改專案檔案，不打擾
    if pfile.exists() and pfile.stat().st_mtime >= edited_at:
        return 0  # 進度檔已在最後一次修改後更新
    ptrack = Path(__file__).resolve()
    action = "更新" if pfile.exists() else "建立"
    reason = (
        f"[project-tracker] 你這次修改了專案 {root.name} 的檔案，但還沒{action}進度檔。"
        f"收工前請：\n"
        f"1. {'' if pfile.exists() else f'執行 `{ptrack} init` 建立進度檔，然後'}"
        f"編輯 {pfile}：更新「目前狀態」「下一步」「待辦」（你完成的標 - [?] 待使用者確認，未完成 - [ ]，不要自己標 - [x]）「卡關／待決事項」，"
        f"並視情況調整 frontmatter 的 status（in_progress／blocked／paused／done）。\n"
        f"2. 執行 `{ptrack} log \"<一句話描述這次做了什麼>\"` 追加歷程。\n"
        f"3. 執行 `{ptrack} stamp --agent \"Claude Code (<你的模型名稱>)\"`。\n"
        f"完成後簡短告知使用者進度已更新即可。"
    )
    print(json.dumps({"decision": "block", "reason": reason}, ensure_ascii=False))
    return 0


COMMANDS = {
    "file": cmd_file, "root": cmd_root, "init": cmd_init, "stamp": cmd_stamp,
    "log": cmd_log, "list": cmd_list, "hook-stop": cmd_hook_stop,
}


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    cmd = COMMANDS.get(argv[0])
    if not cmd:
        print(f"ptrack: 未知指令 {argv[0]}\n", file=sys.stderr)
        print(__doc__, file=sys.stderr)
        return 2
    return cmd(argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
